# ── Connection ──────────────────────────────────────────────────────────────
MT5_BASE_URL=http://localhost:8080

# Symbol for BACKTEST (single). For live use SYMBOLS (comma-separated).
SYMBOL=XAUUSDm
# SYMBOLS=XAUUSDm,GBPUSDm

TIMEFRAME=M15
CANDLE_COUNT=200          # rolling ICT analysis window
CYCLE_SECS=60             # live loop interval (seconds)

# ── Risk ─────────────────────────────────────────────────────────────────────
RISK_PCT=0.01             # risk per trade as decimal (0.01 = 1%)

# ── Backtest ─────────────────────────────────────────────────────────────────
BACKTEST_BALANCE=5000     # starting balance in USD
BACKTEST_CANDLES=50000    # historical candles to fetch

# Optional date range (signal filter only; SL/TP management always runs)
# DATE_FROM=2024-01-01
# DATE_TO=2025-12-31

# ── Friction (Exness Zero account) ──────────────────────────────────────────
COMMISSION_PER_LOT=7.0    # round-trip commission in USD per lot
SLIPPAGE_POINTS=2         # extra SL slippage in MT5 points
SPREAD_OVERRIDE=0         # 0 = Zero/Raw account (commission model, no spread)

# ── ICT Signal Filters ───────────────────────────────────────────────────────
KILLZONE_WINDOWS=08:00-13:00,15:00-18:00   # London + NY killzones (broker time)
SWING_PERIOD=2            # swing detection sensitivity
MIN_RR=2.5                # minimum reward:risk ratio (0 = disabled)
DOW_FILTER=true           # skip Monday (1) and Friday (5)
ATR_MIN_PRICE=0           # skip signals when ATR(14) < this value (0 = disabled)

# ── Trend Filter (EMA) ───────────────────────────────────────────────────────
TREND_EMA_PERIOD=20       # EMA period on TREND_TF (0 = disabled)
TREND_TF=H1               # H1 (reuses candles) or H4 (fetches separately)
TREND_H4_CONFIRM=true     # require H4 EMA direction to agree with H1 EMA
TREND_H4_PERIOD=20        # EMA period for H4 confirmation

# ── Trade Management ─────────────────────────────────────────────────────────
PARTIAL_TP_1R=true        # close 50% at 1R; remainder runs to TP
BREAKEVEN_SL_1R=false     # move SL to entry after 1R (zero-risk trade)
PARTIAL_TP_2R=true        # close 25% of original volume at 2R
TRAILING_2R=false         # move SL to 1R when 2R hit — sweep found this hurts PF
FRIDAY_CLOSE_HOUR=21      # force-close open trades on Friday at/after this UTC hour

# ── Telegram (optional) ──────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=     # bot token from @BotFather (without "bot" prefix)
# TELEGRAM_CHAT_ID=       # chat/group/channel ID (negative for groups)
# TELEGRAM_THREAD_ID=     # topic thread ID (optional, for forum groups)
# SUMMARY_HOUR=21         # UTC hour for daily PnL summary (0-23, omit to disable)
