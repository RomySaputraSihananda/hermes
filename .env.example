# MT5 bridge URL (required)
MT5_BASE_URL=http://localhost:8080

# LLM — only required if USE_LLM=true
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# ── Symbol & Timeframe ──────────────────────────────────────────────────────
SYMBOL=GBPUSDm
TIMEFRAME=H1

# ── Backtest ─────────────────────────────────────────────────────────────────
BACKTEST_BALANCE=600
BACKTEST_CANDLES=50000

# Optional date range (signal generation only; SL/TP management always runs)
# DATE_FROM=2025-01-01
# DATE_TO=2025-12-31

# ── ICT Signal Parameters ────────────────────────────────────────────────────
CANDLE_COUNT=400          # rolling analysis window size
SWING_PERIOD=2            # swing detection sensitivity (beats N neighbours each side)
MIN_RR=5.0                # minimum reward:risk ratio (0 = no filter)

# ── Risk ─────────────────────────────────────────────────────────────────────
RISK_PCT=0.025            # risk per trade as decimal (0.025 = 2.5%)

# ── Friction ─────────────────────────────────────────────────────────────────
COMMISSION_PER_LOT=7      # round-trip commission in USD (Exness Zero = 7.0)
SLIPPAGE_POINTS=5         # extra SL slippage in MT5 points
SPREAD_OVERRIDE=0         # override spread in price units (0 = Zero/Raw account)

# ── Trend Filter (EMA) ───────────────────────────────────────────────────────
TREND_EMA_PERIOD=20       # 0 = disabled; use 100 for USDJPY
TREND_TF=H1               # H1 (uses existing candles) or H4 (fetches separately)

# ── Killzone Windows (broker server time) ────────────────────────────────────
# KILLZONE_WINDOWS=10:00-13:00,15:00-18:00

# ── ATR-based minimum SL ─────────────────────────────────────────────────────
# ATR_SL_MULT=1.0         # reject signals where SL < ATR(14) * multiplier

# ── Trade Management ─────────────────────────────────────────────────────────
BREAKEVEN_SL_1R=false     # move SL to entry after price reaches 1:1 R:R
PARTIAL_TP_1R=false       # close 50% at 1:1 R:R, let remainder run to TP
TIMEOUT_CANDLES=0         # close trade after N candles (0 = disabled)

# ── LLM Agents ───────────────────────────────────────────────────────────────
USE_LLM=false             # set true to enable 4-agent LLM confirmation layer
